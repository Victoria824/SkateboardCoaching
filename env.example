# Replicate API Configuration
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=50000000
UPLOAD_DIR=uploads

# Database Configuration (if using)
DATABASE_URL=your_database_url_here

# Media ingestion service (SQLite is used if omitted)
MEDIA_DATABASE_URL=postgresql+psycopg://snowboard:snowboard@localhost:5432/snowboard
MEDIA_STORAGE_ROOT=./media_service/data/media
MEDIA_MAX_UPLOAD_BYTES=262144000
MEDIA_FRAME_SAMPLE_FPS=1
MEDIA_WORKER_POLL_SECONDS=1
MEDIA_CORS_ORIGINS=http://localhost:3000
MEDIA_API_URL=http://localhost:8000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PII_SCREEN_MODEL=yolo11n.pt

# Reserved for the future S3 adapter; local storage remains the active implementation.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
