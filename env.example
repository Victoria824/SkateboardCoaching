# Replicate API Configuration
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=50000000
UPLOAD_DIR=uploads

# Database Configuration (if using)
DATABASE_URL=your_database_url_here

# Media ingestion service (SQLite is used if omitted)
MEDIA_DATABASE_URL=postgresql+psycopg://snowboard:snowboard@localhost:5432/snowboard
MEDIA_STORAGE_ROOT=./media_service/data/media
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_UPLOAD_BYTES=262144000
MEDIA_FRAME_SAMPLE_FPS=1
MEDIA_WORKER_POLL_SECONDS=1
MEDIA_WORKER_LEASE_SECONDS=1800
MEDIA_QUEUE_BACKEND=database
MEDIA_REDIS_URL=redis://localhost:6379/0
MEDIA_CORS_ORIGINS=http://localhost:3000
MEDIA_API_URL=http://localhost:8000
REACT_APP_DIRECT_UPLOADS=false
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PII_SCREEN_MODEL=yolo11n.pt
MEDIA_RESIDUAL_PII_SCAN=true
MEDIA_RESIDUAL_PII_SCAN_FPS=5
MEDIA_RESIDUAL_PII_CONFIDENCE=0.25
MEDIA_RESIDUAL_PII_MASK_COVERAGE=0.8
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=snowboard-media
S3_ACCESS_KEY=snowboard
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900
S3_PRESIGN_GET_TTL_SECONDS=3600

# Legacy coaching-demo storage settings below are separate from the FastAPI media platform.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
